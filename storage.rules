rules_version = '2';

// Regras de Storage do MVP — autorização por capabilities (Spec 22).
//
// Fonte de autorização: custom claims no ID token (request.auth.token):
//   - ativo:     boolean        (se false, nega tudo)
//   - ids_setor: array<string>  (setores aos quais o usuário pertence)
//   - caps:      array<string>  (capabilities concedidas — Spec 22)
//
// Os claims são provisionados pela Cloud Function `syncClaimsFromUsuario`, que
// espelha `usuarios/{uid}` (capabilities → `caps`). Em ambiente local, o seeder
// injeta os mesmos claims — dev e produção usam UMA versão de regra. Autorização
// 100% por capabilities (Spec 23); não há mais legado de perfil no token.
//
// Produção: pendente de publicação até ativação de Billing/Blaze (Storage real).

service firebase.storage {
  match /b/{bucket}/o {

    // ---- Helpers de claims/capabilities ----
    function autenticado() {
      return request.auth != null;
    }

    function ativo() {
      return autenticado() && request.auth.token.ativo == true;
    }

    function caps() {
      return ('caps' in request.auth.token) ? request.auth.token.caps : [];
    }

    function idsSetor() {
      return ('ids_setor' in request.auth.token) ? request.auth.token.ids_setor : [];
    }
    
    // Capability concedida: usuário ativo cujo claim `caps` contém a capability.
    function temCap(cap) {
      return ativo() && (cap in caps());
    }

    function pertenceAoSetor(idSetor) {
      return ativo() && (idSetor in idsSetor());
    }

    // ---- Helpers de MIME/tamanho (Specs 14/15) ----
    function ehPdf() {
      return request.resource.contentType == 'application/pdf';
    }

    function ehXlsx() {
      return request.resource.contentType ==
        'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet';
    }

    function dentroTetoBiblioteca() {
      return request.resource.size <= 50 * 1024 * 1024;
    }

    // biblioteca/{id_setor}/nivel_1|nivel_2/{id_arquivo}.{pdf|xlsx}
    match /biblioteca/{idSetor}/{nivel}/{arquivo} {
      allow read: if pertenceAoSetor(idSetor)
        && (
          (nivel == 'nivel_1' && temCap('biblioteca_ler_publicos'))
          || (nivel == 'nivel_2' && temCap('biblioteca_ler_privados'))
        );

      allow create, update: if temCap('biblioteca_gerenciar_setor')
        && pertenceAoSetor(idSetor)
        && (ehPdf() || ehXlsx())
        && dentroTetoBiblioteca();

      allow delete: if temCap('biblioteca_gerenciar_setor') && pertenceAoSetor(idSetor);
    }

    // biblioteca_global/nivel_1|nivel_2/{id_arquivo}.{pdf|xlsx}
    match /biblioteca_global/{nivel}/{arquivo} {
      allow read: if (nivel == 'nivel_1' && temCap('biblioteca_ler_publicos'))
        || (nivel == 'nivel_2' && temCap('biblioteca_ler_privados'));

      allow create, update: if temCap('biblioteca_gerenciar_global')
        && (ehPdf() || ehXlsx())
        && dentroTetoBiblioteca();

      allow delete: if temCap('biblioteca_gerenciar_global');
    }

    // solicitacoes/{id_setor}/{id_solicitante}/{id_solicitacao}/resposta.pdf
    match /solicitacoes/{idSetor}/{idSolicitante}/{idSolicitacao}/{arquivo} {
      allow read: if ativo() && request.auth.uid == idSolicitante;

      allow create, update: if temCap('solicitacoes_agir_setor')
        && pertenceAoSetor(idSetor)
        && ehPdf()
        && request.resource.size <= 2 * 1024 * 1024;

      allow delete: if temCap('solicitacoes_agir_setor') && pertenceAoSetor(idSetor);
    }

    // Negar todo o restante por padrão.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
