rules_version = '2';

// Regras de Storage do MVP — endurecidas com Custom Claims (Spec 17).
//
// Fonte de autorização: custom claims no ID token (request.auth.token):
//   - ativo:        boolean  (se false, nega tudo)
//   - nivel_acesso: number   (1 = usuário comum, 2 = admin)
//   - ids_setor:    array<string> (setores aos quais o usuário pertence)
//
// Os claims são provisionados pela Cloud Function `syncClaimsFromUsuario`, que
// espelha `usuarios/{uid}` (ver docs/claims-e-sincronizacao.md). Em ambiente
// local, o seeder injeta os mesmos claims — assim dev e produção usam UMA única
// versão de regra.
//
// Produção: pendente de publicação até ativação de Billing/Blaze (Storage real).
service firebase.storage {
  match /b/{bucket}/o {

    // ---- Helpers de claims ----
    function autenticado() {
      return request.auth != null;
    }
    function ativo() {
      return autenticado() && request.auth.token.ativo == true;
    }
    function ehAdmin() {
      return ativo() && request.auth.token.nivel_acesso == 2;
    }
    function pertenceAoSetor(idSetor) {
      return ativo() && idSetor in request.auth.token.ids_setor;
    }

    // ---- Helpers de MIME/tamanho (Specs 14/15) ----
    function ehPdf() {
      return request.resource.contentType == 'application/pdf';
    }
    function ehXlsx() {
      return request.resource.contentType ==
        'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet';
    }
    // Teto máximo da Biblioteca (50 MB; o limite fino por tipo é imposto na
    // camada de casos de uso/UI — src/servicos/casos_de_uso/regrasUpload.js).
    function dentroTetoBiblioteca() {
      return request.resource.size <= 50 * 1024 * 1024;
    }

    // Caminho oficial da Biblioteca:
    // biblioteca/{id_setor}/nivel_1|nivel_2/{id_arquivo}.{pdf|xlsx}
    match /biblioteca/{idSetor}/{nivel}/{arquivo} {
      // Leitura: usuário ativo do setor. Nível 2 (restrito) exige admin.
      allow read: if pertenceAoSetor(idSetor)
        && (nivel == 'nivel_1' || (nivel == 'nivel_2' && ehAdmin()));

      // Escrita (create/update): somente admin do setor; valida MIME e teto.
      allow create, update: if ehAdmin()
        && pertenceAoSetor(idSetor)
        && (ehPdf() || ehXlsx())
        && dentroTetoBiblioteca();

      // Remoção: somente admin do setor (delete não possui request.resource).
      allow delete: if ehAdmin() && pertenceAoSetor(idSetor);
    }

    // Caminho oficial do anexo final de solicitações:
    // solicitacoes/{id_setor}/{id_solicitante}/{id_solicitacao}/resposta.pdf
    match /solicitacoes/{idSetor}/{idSolicitante}/{idSolicitacao}/{arquivo} {
      // Leitura: SOMENTE o solicitante que criou a solicitação (Spec 17 §2.2),
      // independentemente de perfil. Admin NÃO lê a resposta final.
      allow read: if ativo() && request.auth.uid == idSolicitante;

      // Escrita (create/update): somente admin do setor; PDF até 2 MB (Spec 15).
      allow create, update: if ehAdmin()
        && pertenceAoSetor(idSetor)
        && ehPdf()
        && request.resource.size <= 2 * 1024 * 1024;

      // Remoção: somente admin do setor (delete não possui request.resource).
      allow delete: if ehAdmin() && pertenceAoSetor(idSetor);
    }

    // Negar todo o restante por padrão.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
