# Configuracao do Firebase (Vite). Copie para .env.local e preencha.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=sec-musical-mvp.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sec-musical-mvp
VITE_FIREBASE_STORAGE_BUCKET=sec-musical-mvp.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=875957445341
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Conectar aos emuladores locais em desenvolvimento
VITE_USE_EMULATORS=true

# Infraestrutura de arquivos: "mock" (sem Billing) ou "firebase" (Storage real)
VITE_FILE_INFRA=mock
