# Configuracao do Firebase (Vite). Copie para .env.local e preencha.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=sec-musical-mvp.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sec-musical-mvp
VITE_FIREBASE_STORAGE_BUCKET=sec-musical-mvp.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=875957445341
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Modo da aplicacao (flag unica; deriva emuladores + destino de arquivos):
#   "emulador" — emuladores locais ligados; arquivos reais via Storage emulator
#                (nao exige Billing). Modo de desenvolvimento (padrao).
#   "producao" — sem emuladores; Storage real de PRODUCAO (pendente de Billing;
#                nao considerar concluido enquanto Billing nao estiver ativo).
# Dev e login dependem dos emuladores; por isso o padrao e "emulador".
VITE_APP_MODE=emulador
