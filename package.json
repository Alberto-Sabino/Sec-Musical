{
  "name": "sec-musical-mvp",
  "version": "1.0.0",
  "description": "Portal Musical MVP - Vue + Firebase, execução controlada por documentação.",
  "type": "module",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "emulators": "firebase emulators:start",
    "seed:emulador": "node scripts/seed-emulador.mjs",
    "test:rules": "firebase emulators:exec --only firestore \"node --test --test-concurrency=1 tests/regras\"",
    "lint": "eslint . --fix",
    "format": "eslint . --fix && prettier --write .",
    "format:check": "prettier --check ."
  },
  "author": "Alberto",
  "license": "ISC",
  "dependencies": {
    "firebase": "^11.1.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "10.1.0",
    "eslint": "9.17.0",
    "eslint-plugin-vue": "9.32.0",
    "firebase-tools": "13.29.1",
    "prettier": "3.4.2",
    "vite": "^6.0.7"
  }
}
