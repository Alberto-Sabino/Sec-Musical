rules_version = '2';

// Regras reais do MVP: `usuarios`, `setores`, `arquivos` e `solicitacoes`.
// Princípios: negar tudo por padrão; liberar apenas o necessário;
// isolamento por perfil e setor; transições de status controladas.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----
    function estaAutenticado() {
      return request.auth != null;
    }

    function docUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function estaAtivo() {
      return docUsuario().ativo == true;
    }

    function setoresDoUsuario() {
      return docUsuario().ids_setor;
    }

    function pertenceAoSetor(idSetor) {
      return idSetor in setoresDoUsuario();
    }

    // ---- Capabilities (Spec 23) ----
    // Autorização exclusivamente por capabilities do documento usuarios/{uid}.
    // Ausência de mapa/chave = false (sem legado).
    function temCap(chave) {
      return estaAtivo()
        && ('capabilities' in docUsuario())
        && (chave in docUsuario().capabilities)
        && docUsuario().capabilities[chave] == true;
    }

    // Escopo de um documento de arquivo. Legados sem campo = 'setor' (Spec 18 §3.1).
    function escopoDe(dados) {
      return ('escopo' in dados) ? dados.escopo : 'setor';
    }
    function ehGlobal(dados) {
      return escopoDe(dados) == 'global';
    }
    // Privacidade do arquivo (Spec 23): arquivo_privado=true é restrito; ausência
    // em legados é tratada como público (false).
    function ehPrivado(dados) {
      return ('arquivo_privado' in dados) && dados.arquivo_privado == true;
    }

    // ---- usuarios ----
    // Autenticado lê apenas o próprio documento.
    // Gestão de usuários fica fora do MVP por interface, o que impede elevação de
    // privilégio (capabilities, ids_setor, ativo).
    //
    // Única exceção de escrita (Spec 20 — primeiro acesso): o próprio usuário pode
    // concluir o primeiro acesso, trocando APENAS primeiro_acesso de true → false.
    // Nenhum outro campo pode mudar (diff.changedKeys() == ['primeiro_acesso']),
    // não é possível setar true, nem alterar o doc de outro usuário. create e
    // delete seguem negados.
    function soMudaPrimeiroAcesso() {
      return resource.data.primeiro_acesso == true
        && request.resource.data.primeiro_acesso == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['primeiro_acesso']);
    }
    match /usuarios/{idUsuario} {
      allow read: if estaAutenticado() && request.auth.uid == idUsuario;
      allow update: if estaAutenticado()
        && request.auth.uid == idUsuario
        && soMudaPrimeiroAcesso();
      allow create, delete: if false;
    }

    // ---- setores ----
    // Leitura para exibição do nome do setor. Restrita a autenticado+ativo que
    // pertence ao setor (mesmo isolamento por setor já usado). Sem escrita pelo cliente.
    match /setores/{idSetor} {
      allow read: if estaAutenticado() && estaAtivo() && pertenceAoSetor(idSetor);
      allow write: if false;
    }

    // ---- arquivos ----
    // Escopo (Spec 18): 'setor' (recorte por id_setor) ou 'global' (do sistema).
    // Visibilidade (Spec 23): arquivo_privado (false=público, true=privado).
    // Autorização exclusivamente por capabilities (Spec 23).
    match /arquivos/{idArquivo} {
      // Leitura:
      // - público (arquivo_privado=false): exige biblioteca_ler_publicos;
      // - privado (arquivo_privado=true): exige biblioteca_ler_privados;
      // e (escopo global OU pertence ao setor do arquivo).
      allow read: if estaAutenticado()
        && estaAtivo()
        && (
          (!ehPrivado(resource.data) && temCap('biblioteca_ler_publicos'))
          || (ehPrivado(resource.data) && temCap('biblioteca_ler_privados'))
        )
        && (ehGlobal(resource.data) || pertenceAoSetor(resource.data.id_setor));

      // Criação:
      // - global: biblioteca_gerenciar_global + id_setor ausente;
      // - setor: biblioteca_gerenciar_setor + pertence ao setor.
      // Sempre: id_usuario == próprio uid.
      allow create: if estaAutenticado()
        && request.resource.data.id_usuario == request.auth.uid
        && (
          (ehGlobal(request.resource.data)
            && temCap('biblioteca_gerenciar_global')
            && !('id_setor' in request.resource.data))
          || (!ehGlobal(request.resource.data)
            && temCap('biblioteca_gerenciar_setor')
            && pertenceAoSetor(request.resource.data.id_setor))
        );

      // Atualização:
      // - origem e destino global exigem gerenciar_global (destino sem id_setor);
      // - origem e destino setor exigem gerenciar_setor + pertencer ao setor.
      allow update: if estaAutenticado()
        && (
          (ehGlobal(resource.data) && temCap('biblioteca_gerenciar_global'))
          || (!ehGlobal(resource.data)
            && temCap('biblioteca_gerenciar_setor')
            && pertenceAoSetor(resource.data.id_setor))
        )
        && (
          (ehGlobal(request.resource.data)
            && temCap('biblioteca_gerenciar_global')
            && !('id_setor' in request.resource.data))
          || (!ehGlobal(request.resource.data)
            && temCap('biblioteca_gerenciar_setor')
            && pertenceAoSetor(request.resource.data.id_setor))
        );

      // Remoção:
      // - global: biblioteca_gerenciar_global;
      // - setor: biblioteca_gerenciar_setor + pertence ao setor.
      allow delete: if estaAutenticado()
        && (
          (ehGlobal(resource.data) && temCap('biblioteca_gerenciar_global'))
          || (!ehGlobal(resource.data)
            && temCap('biblioteca_gerenciar_setor')
            && pertenceAoSetor(resource.data.id_setor))
        );

      // Auditoria: apenas quem gerencia a biblioteca do arquivo lê e escreve
      // (setor do arquivo ou global).
      match /auditoria/{idAuditoria} {
        function podeGerenciarArquivoPai() {
          return ehGlobal(get(/databases/$(database)/documents/arquivos/$(idArquivo)).data)
            ? temCap('biblioteca_gerenciar_global')
            : (temCap('biblioteca_gerenciar_setor')
              && pertenceAoSetor(get(/databases/$(database)/documents/arquivos/$(idArquivo)).data.id_setor));
        }
        allow read: if podeGerenciarArquivoPai();
        allow create: if podeGerenciarArquivoPai()
          && request.resource.data.id_usuario == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ---- solicitacoes ----
    match /solicitacoes/{idSolicitacao} {
      // Leitura: solicitante (ver_proprias) lê a própria; admin do setor
      // (ver_setor) lê as do próprio setor.
      allow read: if estaAutenticado() && estaAtivo() && (
        (resource.data.id_solicitante == request.auth.uid && temCap('solicitacoes_ver_proprias'))
        || (temCap('solicitacoes_ver_setor') && pertenceAoSetor(resource.data.id_setor))
      );

      // Criação: solicitante com capability solicitacoes_criar, no próprio setor,
      // com estado inicial correto.
      // nome_beneficiario e descricao são obrigatórios (string não-vazia); conclusao nasce vazia.
      allow create: if estaAutenticado() && estaAtivo()
        && temCap('solicitacoes_criar')
        && request.resource.data.id_solicitante == request.auth.uid
        && pertenceAoSetor(request.resource.data.id_setor)
        && request.resource.data.status == 'em_aberto'
        && request.resource.data.id_responsavel == ''
        && request.resource.data.nome_responsavel == ''
        && request.resource.data.id_nuvem == ''
        && request.resource.data.conclusao == ''
        && request.resource.data.comum_congregacao is string
        && request.resource.data.comum_congregacao.size() > 0
        && request.resource.data.comum_congregacao == docUsuario().comum_congregacao
        && request.resource.data.nome_beneficiario is string
        && request.resource.data.nome_beneficiario.size() > 0
        && request.resource.data.descricao is string
        && request.resource.data.descricao.size() > 0;

      // Atualização pelo solicitante (dono), apenas enquanto em_aberto:
      // - pode manter em_aberto (editar tipo/descricao) ou cancelar;
      // - não altera setor, solicitante, responsável (id/nome), beneficiário, conclusao nem anexo.
      allow update: if estaAutenticado() && estaAtivo()
        && resource.data.id_solicitante == request.auth.uid
        && temCap('solicitacoes_ver_proprias')
        && resource.data.status == 'em_aberto'
        && request.resource.data.status in ['em_aberto', 'cancelada']
        && request.resource.data.id_setor == resource.data.id_setor
        && request.resource.data.id_solicitante == resource.data.id_solicitante
        && request.resource.data.nome_solicitante == resource.data.nome_solicitante
        && request.resource.data.comum_congregacao == resource.data.comum_congregacao
        && request.resource.data.nome_beneficiario == resource.data.nome_beneficiario
        && request.resource.data.id_responsavel == resource.data.id_responsavel
        && request.resource.data.nome_responsavel == resource.data.nome_responsavel
        && request.resource.data.conclusao == resource.data.conclusao
        && request.resource.data.id_nuvem == resource.data.id_nuvem
        && request.resource.data.descricao is string
        && request.resource.data.descricao.size() > 0;

      // Atualização pelo admin do setor, respeitando transições válidas:
      // em_aberto -> em_andamento (assumir; grava id_responsavel = próprio uid
      //   e nome_responsavel = próprio nome)
      // em_andamento -> concluida
      // em_aberto|em_andamento -> cancelada
      // em_andamento -> em_andamento (responder/anexar)
      // Imutáveis para o admin: nome_solicitante, nome_beneficiario e descricao.
      // A conclusao só pode ser gravada/alterada na transição em_andamento -> em_andamento.
      //
      // Decisão de segurança (Spec 17 §2.1): uma vez ASSUMIDA (status em_andamento),
      // somente o responsável que assumiu pode alterá-la. Por isso toda transição
      // cuja ORIGEM é em_andamento exige request.auth.uid == id_responsavel.
      allow update: if temCap('solicitacoes_agir_setor')
        && pertenceAoSetor(resource.data.id_setor)
        && request.resource.data.id_setor == resource.data.id_setor
        && request.resource.data.id_solicitante == resource.data.id_solicitante
        && request.resource.data.nome_solicitante == resource.data.nome_solicitante
        && request.resource.data.comum_congregacao == resource.data.comum_congregacao
        && request.resource.data.nome_beneficiario == resource.data.nome_beneficiario
        && request.resource.data.descricao == resource.data.descricao
        && (
          (resource.data.status == 'em_aberto'
            && request.resource.data.status == 'em_andamento'
            && request.resource.data.id_responsavel == request.auth.uid
            && request.resource.data.nome_responsavel == docUsuario().nome_completo
            && request.resource.data.conclusao == resource.data.conclusao)
          || (resource.data.status == 'em_andamento'
            && request.resource.data.status == 'em_andamento'
            && resource.data.id_responsavel == request.auth.uid)
          || (resource.data.status == 'em_andamento'
            && request.resource.data.status == 'concluida'
            && resource.data.id_responsavel == request.auth.uid
            && request.resource.data.conclusao == resource.data.conclusao)
          || (resource.data.status == 'em_aberto'
            && request.resource.data.status == 'cancelada'
            && request.resource.data.conclusao == resource.data.conclusao)
          || (resource.data.status == 'em_andamento'
            && request.resource.data.status == 'cancelada'
            && resource.data.id_responsavel == request.auth.uid
            && request.resource.data.conclusao == resource.data.conclusao)
        );

      // Sem exclusão de solicitações no MVP.
      allow delete: if false;

      // Auditoria: solicitante e admin do setor podem ler; escrita registra o autor
      // e exige vínculo com a solicitação (dono ou admin do setor).
      match /auditoria/{idAuditoria} {
        function solPai() {
          return get(/databases/$(database)/documents/solicitacoes/$(idSolicitacao)).data;
        }
        function ehSolicitante() {
          return solPai().id_solicitante == request.auth.uid;
        }
        // Visualização do anexo (Spec 21): só o solicitante, com a solicitação
        // concluída e id_nuvem preenchido, registrando status concluida → concluida.
        function anexoVisualizadoValido() {
          return ehSolicitante()
            && solPai().status == 'concluida'
            && solPai().id_nuvem != ''
            && request.resource.data.status_anterior == 'concluida'
            && request.resource.data.status_novo == 'concluida';
        }
        allow read: if estaAutenticado() && estaAtivo() && (
          ehSolicitante()
          || (temCap('solicitacoes_ver_setor') && pertenceAoSetor(solPai().id_setor))
        );
        allow create: if estaAutenticado() && estaAtivo()
          && request.resource.data.id_usuario == request.auth.uid
          && (
            request.resource.data.acao == 'anexo_visualizado'
              ? anexoVisualizadoValido()
              : (ehSolicitante() || (temCap('solicitacoes_ver_setor') && pertenceAoSetor(solPai().id_setor)))
          );
        allow update, delete: if false;
      }
    }
  }
}
